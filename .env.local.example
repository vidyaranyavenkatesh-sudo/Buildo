# Supabase - from Project Settings > API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini - from https://aistudio.google.com/apikey
# This key is only used on the server (app/api/generate/route.js) and is never sent to the browser.
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model. Google renames/retires models periodically,
# check https://ai.google.dev/gemini-api/docs/models if generation starts failing.
GEMINI_MODEL=gemini-2.5-flash
